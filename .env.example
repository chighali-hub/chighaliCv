# Variables d'environnement du formulaire de contact.
# Copier ce fichier en .env.local pour le développement (vercel dev),
# et déclarer les mêmes clés dans Vercel : Settings -> Environment Variables.
# Aucune valeur réelle ne doit être commitée.

# Clé API Resend (obligatoire). Obtenue sur https://resend.com/api-keys
RESEND_API_KEY=

# Adresse de destination (optionnel, défaut : habottchighali@gmail.com)
CONTACT_TO=

# Expéditeur (optionnel, défaut : Portfolio <onboarding@resend.dev>).
# Pour un expéditeur personnalisé, vérifier un domaine dans Resend.
CONTACT_FROM=
